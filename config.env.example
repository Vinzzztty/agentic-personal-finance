# Spreadsheet Configuration
SPREADSHEET_URL="https://docs.google.com/spreadsheets/d/1Rf-k_kP4GRrbXrXUu1w6R4tXF6R6TUGQcYNOMzVR8t4/edit?usp=sharing" # For Demo
SHEET_NAME=Transaksi

# Ollama Configuration
OLLAMA_MODEL=deepseek-r1:8b

# Tag Cleaning Configuration
# Set to "true" to enable automatic cleaning of reasoning tags from DeepSeek R1:8B
# Set to "false" to disable tag cleaning
CLEAN_REASONING_TAGS=true

# Aggressive Cleaning Mode
# Set to "false" for basic cleaning (only removes complete tags)
# Set to "true" for more thorough cleaning (removes incomplete tags, cleans formatting)
AGGRESSIVE_CLEANING=true

# Streaming Configuration
# Set to "true" to enable real-time streaming responses (recommended for large models)
# Set to "false" to disable streaming and wait for complete response
ENABLE_STREAMING=true

# Streaming Chunk Size
# Number of characters to accumulate before sending updates (higher = smoother, lower = more responsive)
STREAMING_CHUNK_SIZE=50

# Optimization Configuration
# Set to "true" to enable performance optimizations (context reduction, caching, etc.)
ENABLE_OPTIMIZATION=true

# Context Length Limits
# Maximum context size in characters (lower = faster, higher = more detailed)
MAX_CONTEXT_LENGTH=2000

# Response Length Limits
# Maximum response size in characters (lower = faster, higher = more detailed)
MAX_RESPONSE_LENGTH=1000

# Caching Configuration
# Set to "true" to enable response caching for repeated questions
ENABLE_CACHING=true

# Cache Size
# Number of cached responses to store (higher = more cache hits, higher memory usage)
CACHE_SIZE=100

# Parallel Processing
# Set to "true" to enable parallel processing (experimental)
ENABLE_PARALLEL=false

# Logging Configuration
# Set to "DEBUG" for detailed logging, "INFO" for normal logging
LOG_LEVEL=INFO

# Example configurations for different models:
# 
# For DeepSeek R1:8B (with reasoning tags, streaming and optimization recommended):
# OLLAMA_MODEL=deepseek-r1:8b
# CLEAN_REASONING_TAGS=true
# AGGRESSIVE_CLEANING=true
# ENABLE_STREAMING=true
# STREAMING_CHUNK_SIZE=50
# ENABLE_OPTIMIZATION=true
# MAX_CONTEXT_LENGTH=2000
# MAX_RESPONSE_LENGTH=1000
# ENABLE_CACHING=true
# CACHE_SIZE=100
#
# For Gemma3:4b (no reasoning tags, moderate optimization):
# OLLAMA_MODEL=gemma3:4b
# CLEAN_REASONING_TAGS=false
# AGGRESSIVE_CLEANING=false
# ENABLE_STREAMING=true
# STREAMING_CHUNK_SIZE=30
# ENABLE_OPTIMIZATION=true
# MAX_CONTEXT_LENGTH=3000
# MAX_RESPONSE_LENGTH=1500
# ENABLE_CACHING=true
# CACHE_SIZE=50
#
# For Llama3 (no reasoning tags, moderate optimization):
# OLLAMA_MODEL=llama3
# CLEAN_REASONING_TAGS=false
# AGGRESSIVE_CLEANING=false
# ENABLE_STREAMING=true
# STREAMING_CHUNK_SIZE=40
# ENABLE_OPTIMIZATION=true
# MAX_CONTEXT_LENGTH=3000
# MAX_RESPONSE_LENGTH=1500
# ENABLE_CACHING=true
# CACHE_SIZE=75
